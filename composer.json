{
  "name": "nplesa/observer",
  "description": "Observer package for Laravel",
  "type": "library",
  "license": "MIT",
  "autoload": {
      "psr-4": {
          "nplesa\\observer\\": "src/"
      }
  },
  "extra": {
      "laravel": {
          "providers": [
              "nplesa\\observer\\ObserverServiceProvider"
          ]
      }
  },
  "require": {
